# Kotlin formatting rules. Spotless (ktlint) and the IDE both read this file.
# Applying and checking: docs/conventions.md, "포맷 · 린트".
root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 120

# The official Kotlin style as the IDE formats it (gradle.properties: kotlin.code.style=official).
ktlint_code_style = intellij_idea

# Composable functions are named like types.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Unused imports are removed (not on by default in this ktlint).
ktlint_standard_no-unused-imports = enabled
